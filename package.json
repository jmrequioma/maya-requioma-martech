{
  "name": "maya-requioma-martech",
  "version": "1.0.0",
  "description": "Send Money Limits Module",
  "keywords": [
    "money"
  ],
  "homepage": "https://github.com/jmrequioma/maya-requioma-martech#readme",
  "bugs": {
    "url": "https://github.com/jmrequioma/maya-requioma-martech/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrequioma/maya-requioma-martech.git"
  },
  "license": "ISC",
  "author": "Jerome Requioma",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts,js --exec 'tsc && node' dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write 'src/**/*.{js,ts}' && npm run lint:fix",
    "migrate": "sequelize-cli db:migrate --config config/config.cjs",
    "migrate:undo": "sequelize-cli db:migrate:undo --config config/config.cjs",
    "migrate:undoAll": "sequelize-cli db:migrate:undo:all --config config/config.cjs",
    "seed": "sequelize-cli db:seed:all --config config/config.cjs",
    "seed:undo": "sequelize-cli db:seed:undo --config config/config.cjs",
    "seed:undoAll": "sequelize-cli db:seed:undo:all --config config/config.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/ui": "^5.0.5",
    "eslint": "^8.57.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.10",
    "sequelize-cli": "^6.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
